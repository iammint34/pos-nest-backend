// POS Local Backend - Prisma Schema (SQLite)
// Stores synced data from Portal and local orders

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// =====================
// Device Configuration
// =====================

model DeviceConfig {
  id                String    @id @default(uuid())
  deviceIdentifier  String    @unique @map("device_identifier")
  deviceName        String?   @map("device_name")
  storeId           String    @map("store_id")
  storeName         String?   @map("store_name")
  branchId          String    @map("branch_id")
  branchName        String?   @map("branch_name")
  deviceToken       String?   @map("device_token")
  tokenExpiresAt    DateTime? @map("token_expires_at")
  lastSyncAt        DateTime? @map("last_sync_at")
  lastSyncVersion   Int?      @map("last_sync_version")
  isRegistered      Boolean   @default(false) @map("is_registered")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  // BIR Compliance - Store Info (synced from Portal)
  registeredName      String?   @map("registered_name")    // Official BIR-registered business name
  registeredAddress   String?   @map("registered_address") // BIR-registered address
  vatTin              String?   @map("vat_tin")            // VAT Registration TIN
  isVatRegistered     Boolean   @default(true) @map("is_vat_registered")

  // BIR Compliance - Branch/Device Info (synced from Portal)
  min                 String?                              // Machine Identification Number
  serialNumber        String?   @map("serial_number")      // Hardware serial number
  permitNumber        String?   @map("permit_number")      // BIR permit number for this machine
  ptuNo               String?   @map("ptu_no")             // Permit To Use Number
  ptuDateIssued       String?   @map("ptu_date_issued")    // Date PTU was issued
  ptuValidUntil       String?   @map("ptu_valid_until")    // PTU expiry date
  accreditationNo     String?   @map("accreditation_no")   // BIR Accreditation Number

  // BIR Compliance - Counters (Non-resettable)
  nextInvoiceNumber   Int       @default(1) @map("next_invoice_number")  // Next sequential invoice number
  grandTotalAccum     Decimal   @default(0) @map("grand_total_accum")    // Non-resettable grand total accumulator
  zCounterNo          Int       @default(0) @map("z_counter_no")         // Non-resettable Z-counter

  @@map("device_config")
}

// =====================
// Users (Synced from Portal)
// =====================

enum UserRole {
  MANAGER
  STAFF
}

model User {
  id            String    @id @default(uuid())
  portalUserId  String    @unique @map("portal_user_id") // ID from Portal
  email         String    @unique
  passwordHash  String    @map("password_hash")
  firstName     String    @map("first_name")
  lastName      String    @map("last_name")
  role          UserRole  @default(STAFF)
  permissions   String?   @map("permissions") // JSON array of permission codes (e.g., pos_function.*)
  pin           String?   // Optional quick PIN for fast login
  isActive      Boolean   @default(true) @map("is_active")
  lastLoginAt   DateTime? @map("last_login_at")
  syncedAt      DateTime  @default(now()) @map("synced_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  orders        Order[]
  sessions      UserSession[]
  shifts        Shift[]

  @@map("users")
}

model UserSession {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  token       String    @unique
  expiresAt   DateTime  @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  // Relations
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}

// =====================
// Categories (Synced from Portal)
// =====================

model Category {
  id            String    @id @default(uuid())
  portalId      String    @unique @map("portal_id") // ID from Portal
  name          String
  description   String?
  sortOrder     Int       @default(0) @map("sort_order")
  isActive      Boolean   @default(true) @map("is_active")
  syncedAt      DateTime  @default(now()) @map("synced_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  items         Item[]

  @@map("categories")
}

// =====================
// Items (Synced from Portal)
// =====================

model Item {
  id            String    @id @default(uuid())
  portalId      String    @unique @map("portal_id") // ID from Portal
  categoryId    String?   @map("category_id")
  sku           String?
  name          String
  description   String?
  price         Decimal   @default(0)
  isActive      Boolean   @default(true) @map("is_active")
  isAvailable   Boolean   @default(true) @map("is_available") // Branch-specific availability
  version       Int       @default(1)
  syncedAt      DateTime  @default(now()) @map("synced_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  category        Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  orderItems      OrderItem[]
  branchInventory BranchInventory?

  @@index([categoryId])
  @@index([sku])
  @@map("items")
}

// =====================
// Shifts & Cash Management
// =====================

enum ShiftStatus {
  OPEN
  CLOSED
}

model Shift {
  id            String      @id @default(uuid())
  operatorId    String      @map("operator_id")
  status        ShiftStatus @default(OPEN)
  openedAt      DateTime    @default(now()) @map("opened_at")
  closedAt      DateTime?   @map("closed_at")
  openingCash   Decimal     @default(0) @map("opening_cash")
  closingCash   Decimal?    @map("closing_cash")
  expectedCash  Decimal?    @map("expected_cash")
  variance      Decimal?
  notes         String?
  syncStatus    String      @default("PENDING") @map("sync_status")
  syncedAt      DateTime?   @map("synced_at")
  portalShiftId String?     @map("portal_shift_id")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  // Relations
  operator      User          @relation(fields: [operatorId], references: [id])
  cashMovements CashMovement[]
  orders        Order[]

  @@index([operatorId])
  @@index([status])
  @@index([syncStatus])
  @@map("shifts")
}

enum CashMovementType {
  OPENING_FLOAT
  CASH_SALE
  CHANGE_GIVEN
  TIP_CASH
  PAID_OUT
  DROP
  CASH_IN
  REFUND
  CLOSING_COUNT
}

model CashMovement {
  id            String           @id @default(uuid())
  shiftId       String           @map("shift_id")
  movementType  CashMovementType @map("movement_type")
  amount        Decimal
  referenceType String?          @map("reference_type")
  referenceId   String?          @map("reference_id")
  reason        String?
  performedBy   String           @map("performed_by")
  performedAt   DateTime         @default(now()) @map("performed_at")
  createdAt     DateTime         @default(now()) @map("created_at")

  // Relations
  shift         Shift            @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([shiftId])
  @@map("cash_movements")
}

// =====================
// Orders (Local)
// =====================

enum OrderStatus {
  OPEN        // Currently being edited
  HELD        // Parked for later
  COMPLETED   // Paid and closed
  VOIDED      // Cancelled
}

enum OrderType {
  DINE_IN
  TAKEOUT
  DELIVERY
  DRIVE_THRU
}

model Order {
  id              String      @id @default(uuid())
  orderNumber     String      @unique @map("order_number") // e.g., "001", "002"
  invoiceNumber   String?     @unique @map("invoice_number") // BIR sequential invoice number (e.g., "SI-000001")
  orderType       OrderType   @default(DINE_IN) @map("order_type")
  status          OrderStatus @default(OPEN)
  userId          String      @map("user_id") // Cashier who created
  shiftId         String?     @map("shift_id") // Current shift (optional for backward compatibility)
  operatorId      String?     @map("operator_id") // Operator who handled the order
  customerName    String?     @map("customer_name")
  customerPhone   String?     @map("customer_phone")
  subtotal        Decimal     @default(0)
  discountTotal   Decimal     @default(0) @map("discount_total")
  taxTotal        Decimal     @default(0) @map("tax_total")
  grandTotal      Decimal     @default(0) @map("grand_total")

  // BIR VAT Breakdown
  vatableSales    Decimal     @default(0) @map("vatable_sales")    // VATable portion (grandTotal / 1.12)
  vatAmount       Decimal     @default(0) @map("vat_amount")       // 12% VAT amount
  vatExemptSales  Decimal     @default(0) @map("vat_exempt_sales") // VAT-exempt sales
  zeroRatedSales  Decimal     @default(0) @map("zero_rated_sales") // Zero-rated sales

  // B2B Customer Info (for claiming input tax)
  customerTin             String?   @map("customer_tin")
  customerBusinessName    String?   @map("customer_business_name")
  customerBusinessAddress String?   @map("customer_business_address")

  notes           String?
  syncStatus      String      @default("PENDING") @map("sync_status") // PENDING, SYNCED, FAILED
  syncedAt        DateTime?   @map("synced_at")
  portalOrderId   String?     @map("portal_order_id") // ID from Portal after sync
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  closedAt        DateTime?   @map("closed_at")

  // Relations
  user            User        @relation(fields: [userId], references: [id])
  shift           Shift?      @relation(fields: [shiftId], references: [id])
  orderItems      OrderItem[]
  discounts       OrderDiscount[]
  payments        Payment[]

  @@index([userId])
  @@index([shiftId])
  @@index([status])
  @@index([syncStatus])
  @@index([invoiceNumber])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id              String    @id @default(uuid())
  orderId         String    @map("order_id")
  itemId          String?   @map("item_id")
  itemName        String    @map("item_name") // Denormalized
  itemSku         String?   @map("item_sku")
  quantity        Int       @default(1)
  unitPrice       Decimal   @map("unit_price")
  discountAmount  Decimal   @default(0) @map("discount_amount")
  taxAmount       Decimal   @default(0) @map("tax_amount")
  totalPrice      Decimal   @map("total_price")
  notes           String?
  isVoided        Boolean   @default(false) @map("is_voided")
  voidReason      String?   @map("void_reason")
  voidedBy        String?   @map("voided_by") // User ID who voided
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item            Item?     @relation(fields: [itemId], references: [id], onDelete: SetNull)
  discounts       OrderDiscount[]

  @@index([orderId])
  @@index([itemId])
  @@map("order_items")
}

// =====================
// Discounts
// =====================

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum DiscountScope {
  ORDER
  ITEM
}

model OrderDiscount {
  id              String        @id @default(uuid())
  orderId         String        @map("order_id")
  orderItemId     String?       @map("order_item_id")
  discountName    String        @map("discount_name")
  discountType    DiscountType  @map("discount_type")
  discountScope   DiscountScope @map("discount_scope")
  discountValue   Decimal       @map("discount_value") // Percentage or amount
  discountAmount  Decimal       @map("discount_amount") // Actual amount discounted
  reason          String?
  appliedBy       String        @map("applied_by") // User ID
  createdAt       DateTime      @default(now()) @map("created_at")

  // Relations
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem       OrderItem?    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([orderItemId])
  @@map("order_discounts")
}

// =====================
// Payments
// =====================

enum PaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  MOBILE_PAYMENT
  GIFT_CARD
  STORE_CREDIT
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model Payment {
  id              String        @id @default(uuid())
  orderId         String        @map("order_id")
  paymentMethod   PaymentMethod @map("payment_method")
  status          PaymentStatus @default(COMPLETED)
  amount          Decimal
  tipAmount       Decimal       @default(0) @map("tip_amount")
  changeAmount    Decimal       @default(0) @map("change_amount")
  referenceNumber String?       @map("reference_number")
  processedBy     String        @map("processed_by") // User ID
  processedAt     DateTime      @default(now()) @map("processed_at")
  createdAt       DateTime      @default(now()) @map("created_at")

  // Relations
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds         Refund[]

  @@index([orderId])
  @@map("payments")
}

model Refund {
  id              String        @id @default(uuid())
  paymentId       String        @map("payment_id")
  orderId         String        @map("order_id")
  amount          Decimal
  reason          String?
  refundMethod    PaymentMethod @map("refund_method")
  processedBy     String        @map("processed_by") // User ID (must be Manager)
  processedAt     DateTime      @default(now()) @map("processed_at")
  createdAt       DateTime      @default(now()) @map("created_at")

  // Relations
  payment         Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([orderId])
  @@map("refunds")
}

// =====================
// Sync Queue (POS → Portal)
// =====================

enum SyncOperation {
  CREATE_ORDER
  VOID_ORDER
  REFUND
  SYNC_SHIFT
  SYNC_ZREADING
  SYNC_INVENTORY_MOVEMENT
}

enum SyncQueueStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

model SyncQueue {
  id            String          @id @default(uuid())
  operation     SyncOperation
  entityType    String          @map("entity_type") // Order, Refund, etc.
  entityId      String          @map("entity_id")
  payload       String          // JSON payload
  status        SyncQueueStatus @default(PENDING)
  attempts      Int             @default(0)
  lastAttemptAt DateTime?       @map("last_attempt_at")
  errorMessage  String?         @map("error_message")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@index([status])
  @@index([createdAt])
  @@map("sync_queue")
}

// =====================
// Sync Log (History)
// =====================

enum SyncDirection {
  PORTAL_TO_POS
  POS_TO_PORTAL
}

enum SyncLogStatus {
  SUCCESS
  FAILED
  PARTIAL
}

model SyncLog {
  id            String        @id @default(uuid())
  direction     SyncDirection
  syncType      String        @map("sync_type") // USERS, ITEMS, CATEGORIES, ORDERS
  status        SyncLogStatus
  itemCount     Int?          @map("item_count")
  errorMessage  String?       @map("error_message")
  startedAt     DateTime      @map("started_at")
  completedAt   DateTime?     @map("completed_at")
  createdAt     DateTime      @default(now()) @map("created_at")

  @@index([direction])
  @@index([syncType])
  @@index([createdAt])
  @@map("sync_logs")
}

// =====================
// BIR Compliance - Grand Total Log (Append-only, Non-resettable)
// =====================

model GrandTotalLog {
  id                String    @id @default(uuid())
  orderId           String    @map("order_id")
  invoiceNumber     String    @map("invoice_number")
  amount            Decimal                            // Amount added to grand total
  runningTotal      Decimal   @map("running_total")   // New grand total after this transaction
  transactionType   String    @map("transaction_type") // SALE, VOID, REFUND
  createdAt         DateTime  @default(now()) @map("created_at")

  // Note: This table is append-only. No UPDATE or DELETE operations allowed.
  @@index([orderId])
  @@index([createdAt])
  @@map("grand_total_log")
}

// =====================
// BIR Compliance - Z-Reading (End-of-Day Report)
// =====================

model ZReading {
  id                    String    @id @default(uuid())

  // Z-Counter (Non-resettable, increments daily)
  zCounterNo            Int       @unique @map("z_counter_no")

  // Invoice Range for the day
  beginningInvoiceNo    String    @map("beginning_invoice_no")
  endingInvoiceNo       String    @map("ending_invoice_no")

  // Grand Total Tracking (Non-resettable)
  beginningGrandTotal   Decimal   @map("beginning_grand_total")
  endingGrandTotal      Decimal   @map("ending_grand_total")

  // Daily Sales Summary
  grossSales            Decimal   @map("gross_sales")
  netSales              Decimal   @map("net_sales")
  vatableSales          Decimal   @map("vatable_sales")
  vatAmount             Decimal   @map("vat_amount")
  vatExemptSales        Decimal   @map("vat_exempt_sales")
  zeroRatedSales        Decimal   @map("zero_rated_sales")

  // Adjustments
  discountTotal         Decimal   @default(0) @map("discount_total")
  refundTotal           Decimal   @default(0) @map("refund_total")
  voidTotal             Decimal   @default(0) @map("void_total")

  // Transaction Counts
  transactionCount      Int       @map("transaction_count")
  voidCount             Int       @default(0) @map("void_count")
  refundCount           Int       @default(0) @map("refund_count")

  // Metadata
  closedBy              String    @map("closed_by")
  closedAt              DateTime  @map("closed_at")
  syncStatus            String    @default("PENDING") @map("sync_status")
  syncedAt              DateTime? @map("synced_at")
  portalZReadingId      String?   @map("portal_zreading_id")
  createdAt             DateTime  @default(now()) @map("created_at")

  @@index([closedAt])
  @@index([syncStatus])
  @@map("z_readings")
}

// =====================
// BIR Compliance - Electronic Journal (Immutable Receipt Archive)
// =====================

model ElectronicJournal {
  id                String    @id @default(uuid())

  // Transaction Reference
  orderId           String    @map("order_id")
  invoiceNumber     String    @map("invoice_number")
  transactionType   String    @map("transaction_type") // SALE, VOID, REFUND

  // Receipt Content (Read-only, immutable record)
  receiptContent    String    @map("receipt_content") // Full receipt text/JSON
  receiptHash       String    @map("receipt_hash")    // SHA-256 hash for integrity

  // Amounts
  grandTotal        Decimal   @map("grand_total")
  vatAmount         Decimal   @map("vat_amount")

  // Operator Info
  operatorId        String    @map("operator_id")
  operatorName      String    @map("operator_name")

  // Timestamps
  transactionDate   DateTime  @map("transaction_date")
  syncStatus        String    @default("PENDING") @map("sync_status")
  syncedAt          DateTime? @map("synced_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  // Note: This table is append-only. No UPDATE or DELETE operations allowed.
  @@index([orderId])
  @@index([invoiceNumber])
  @@index([transactionDate])
  @@index([syncStatus])
  @@map("electronic_journal")
}

// =====================
// Inventory Management
// =====================

enum MovementType {
  RECEIVED
  SOLD
  ADJUSTED_UP
  ADJUSTED_DOWN
  WASTED
  VOIDED_SALE
  REFUNDED
  TRANSFER_IN
  TRANSFER_OUT
}

enum MovementSyncStatus {
  PENDING
  SYNCED
  FAILED
}

model BranchInventory {
  id                String   @id @default(uuid())
  portalId          String?  @unique @map("portal_id") // ID from Portal for sync
  itemId            String   @map("item_id")
  currentQuantity   Int      @default(0) @map("current_quantity")
  lowStockThreshold Int?     @map("low_stock_threshold")
  isTracked         Boolean  @default(true) @map("is_tracked")
  syncedAt          DateTime? @map("synced_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  item      Item                @relation(fields: [itemId], references: [id], onDelete: Cascade)
  movements InventoryMovement[]

  @@unique([itemId])
  @@map("branch_inventory")
}

model InventoryMovement {
  id                String             @id @default(uuid())
  movementId        String             @unique @map("movement_id") // Unique ID for idempotent sync
  branchInventoryId String             @map("branch_inventory_id")
  itemId            String             @map("item_id")
  movementType      MovementType       @map("movement_type")
  quantity          Int
  previousQuantity  Int                @map("previous_quantity")
  newQuantity       Int                @map("new_quantity")
  referenceType     String?            @map("reference_type") // ORDER, REFUND, ADJUSTMENT, etc.
  referenceId       String?            @map("reference_id")
  reason            String?
  performedBy       String?            @map("performed_by")
  performedAt       DateTime           @map("performed_at")
  syncStatus        MovementSyncStatus @default(PENDING) @map("sync_status")
  syncedAt          DateTime?          @map("synced_at")
  createdAt         DateTime           @default(now()) @map("created_at")

  // Relations
  branchInventory BranchInventory @relation(fields: [branchInventoryId], references: [id], onDelete: Cascade)

  @@index([branchInventoryId])
  @@index([itemId])
  @@index([movementType])
  @@index([performedAt])
  @@index([syncStatus])
  @@map("inventory_movements")
}
